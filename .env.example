# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-this-in-production-charan-2026

# Database Configuration
# Default is SQLite for instant local development:
DATABASE_URL=sqlite:///portfolio.db
# For MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/portfolio_db

# Upload limits (in bytes: 16MB)
MAX_CONTENT_LENGTH=16777216
